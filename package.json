{
  "name": "pi-watch",
  "version": "0.5.0",
  "description": "A pi extension that watches videos via the cheapest path that works (transcript → sampled-frame vision → frames-into-context), local-first and model-agnostic.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/contract/index.js",
  "types": "dist/contract/index.d.ts",
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/watch/extension.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^22.20.4",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
